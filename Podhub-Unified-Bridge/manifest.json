{
  "manifest_version": 3,
  "name": "Podhub GPTs Bridge",
  "version": "0.1.9.5",
  "version_name": "0.1.9-5-stable-queue-sync",
  "description": "Unified Podhub browser bridge for Clone, Redesign, and Mockup modules.",
  "permissions": ["storage", "tabs", "windows", "downloads"],
  "host_permissions": [
    "https://podhub.space/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.oaistatic.com/*",
    "https://*.blob.core.windows.net/*",
    "https://www.etsy.com/*",
    "https://*.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://www.amazon.com/*",
    "https://*.amazon.com/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Podhub GPTs Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "ui-fix.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.etsy.com/*", "https://*.etsy.com/*", "https://www.amazon.com/*", "https://*.amazon.com/*"],
      "js": ["marketplace.js"],
      "run_at": "document_idle"
    }
  ]
}
