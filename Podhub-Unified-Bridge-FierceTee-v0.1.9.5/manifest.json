{
  "manifest_version": 3,
  "name": "FierceTee Unified Bridge",
  "version": "0.1.9.5",
  "version_name": "0.1.9-5-fiercetee-team",
  "description": "Bản Unified Bridge v0.1.9.5 riêng cho team FierceTee: Clone, Redesign và Mockup.",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://tools.podhub.space/*",
    "https://api.fiercetee.com/*",
    "https://ex.podhub.space/*",
    "https://www.ex.podhub.space/*",
    "https://www.etsy.com/*",
    "https://*.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://www.amazon.com/*",
    "https://*.amazon.com/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "FierceTee Unified Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "ui-fix.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.etsy.com/*", "https://*.etsy.com/*", "https://www.amazon.com/*", "https://*.amazon.com/*"],
      "js": ["marketplace.js"],
      "run_at": "document_idle"
    }
  ]
}
